{
  "name": "pagina-chira",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "node scripts/build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "node --env-file=.env server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "configure:api": "node scripts/configure-api.mjs",
    "server:production": "node server/index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prestart": "npm run prepare:assets",
    "prewatch": "npm run prepare:assets",
    "prepare:assets": "node scripts/prepare-assets.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/platform-server": "20.3.34",
    "@angular/router": "20.3.34",
    "@angular/ssr": "20.3.41",
    "gsap": "^3.15.0",
    "libphonenumber-js": "^1.13.15",
    "mongodb": "^7.7.0",
    "primeicons": "^8.0.2",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.41",
    "@angular/cli": "20.3.41",
    "@angular/compiler-cli": "20.3.34",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
